# Paste these keys into Render Dashboard -> Environment -> Add from .env.
# Do not commit a file containing your real MongoDB URI or passwords.

NODE_ENV=production
PORT=10000
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-db-password>@<cluster-host>/raja-electricals?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-secret-at-least-32-characters>
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<choose-a-strong-admin-password>
VITE_SUPABASE_URL=https://yfbzapzceoqkwzsmsjmk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY